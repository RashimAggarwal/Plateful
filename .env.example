# Copy to .env and replace these safe placeholders before running Docker Compose.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER_HOST/plateful?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000

# Local Docker ports and browser-visible API URL. For deployment, set API_URL to
# the public API URL (or /api when a reverse proxy serves the API on this origin).
BACKEND_PORT=4000
FRONTEND_PORT=8080
API_URL=http://localhost:4000/api
CLIENT_ORIGIN=http://localhost:8080
